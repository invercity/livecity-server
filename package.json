{
  "name": "livecity-server",
  "version": "1.0.0",
  "private": true,
  "description": "Modern city traffic monitoring system (NestJS + Mongoose + React + Google Maps API)",
  "engines": {
    "node": ">=24.0.0"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "node dev-runner.mjs",
    "dev:api": "npm --workspace=@livecity/api run start:dev",
    "dev:web": "npm --workspace=@livecity/web run dev",
    "build": "npm --workspaces --if-present run build",
    "typecheck": "npm --workspaces --if-present run typecheck",
    "test": "npm --workspaces --if-present run test"
  },
  "allowScripts": {
    "esbuild@0.25.12": true,
    "fsevents@2.3.3": true
  }
}
